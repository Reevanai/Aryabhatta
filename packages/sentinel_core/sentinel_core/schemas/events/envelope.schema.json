{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel.invalid/schemas/events/envelope.schema.json",
  "title": "Sentinel event envelope",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "tenant_id",
    "occurred_at",
    "producer",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique id; consumers deduplicate on it"
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z_]+(\\.[a-z_]+)+$"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "branch_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC"
    },
    "producer": {
      "type": "string",
      "description": "Module that emitted the event"
    },
    "trace_id": {
      "type": "string"
    },
    "causation_id": {
      "type": "string",
      "format": "uuid",
      "description": "event_id of the event that caused this one"
    },
    "purpose": {
      "type": "string",
      "description": "Processing purpose tag the producer acted under"
    },
    "payload": {
      "type": "object"
    }
  }
}
